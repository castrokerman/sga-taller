# Copia este fichero como ".env" y cambia las contraseñas.
# El fichero .env nunca se sube a GitHub.

# --- Base de datos ---
POSTGRES_DB=sga
POSTGRES_USER=sga
# Solo letras y números: va dentro de una dirección de conexión.
POSTGRES_PASSWORD=CambiaEstaClave123

# --- Primer administrador ---
# Se crea la primera vez que arranca el sistema. Mínimo 10 caracteres.
# Al entrar por primera vez, el sistema obliga a cambiarla.
# Después del primer arranque ya no se usa: puedes dejar la línea vacía.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# --- Usuarios de demostración ---
# "true" crea cuatro usuarios ficticios (demo.almacen, demo.proyecto,
# demo.usuario, demo.consulta) con la contraseña demo-ficticio-2026.
# Déjalo en "false" cuando el sistema tenga datos reales.
SEED_DEMO=true

# --- Acceso ---
# Direcciones por las que se entra al sistema.
#   Solo desde este ordenador:   localhost
#   Desde la red del taller:     localhost, 192.168.1.50   (la IP de este ordenador)
#   En un servidor online:       sga.miempresa.com
SITE_ADDRESS=localhost
# La misma IP del PC que en SITE_ADDRESS, sola. Necesaria para entrar desde el móvil.
DEFAULT_SNI=localhost
# "internal" en red local. En un servidor online, un correo electrónico.
TLS_MODE=internal

HTTP_PORT=80
HTTPS_PORT=443
# Si cambias HTTPS_PORT, pon aquí dos puntos y ese puerto, por ejemplo HTTPS_SUFFIX=:8443
HTTPS_SUFFIX=

# --- Copias de seguridad ---
# Carpeta donde se guardan. Lo recomendable es otro disco o una carpeta de red,
# por ejemplo:  BACKUP_PATH=D:/copias-sga
BACKUP_PATH=./backups
# Días que se conserva cada copia.
BACKUP_KEEP_DAYS=30
