# Proxy del SGA: única puerta de entrada.
# Sirve la web, reenvía /api a la API y pone HTTPS siempre.
#
# Variables (se definen en el fichero .env):
#   SITE_ADDRESS  Direcciones por las que se accede. Por defecto, localhost.
#                 En la red del taller: "localhost, 192.168.1.50" (la IP del PC).
#                 En un servidor online: el dominio, p. ej. "sga.miempresa.com".
#   DEFAULT_SNI   La IP del PC en la red del taller. Los móviles que entran por IP
#                 no dicen a qué sitio van; sin esto, el cifrado falla.
#   TLS_MODE      "internal" = certificado propio (red local).
#                 Un correo electrónico = certificado público automático (servidor online).
{
	admin off
	http_port {$HTTP_LISTEN_PORT:80}
	# La redirección a HTTPS la hace el bloque de abajo, que deja pasar la página del móvil.
	auto_https disable_redirects
	default_sni {$DEFAULT_SNI:localhost}
}

# Sin HTTPS solo se sirve la página para conectar un móvil y el certificado
# raíz del sistema. Todo lo demás se redirige a la versión segura.
:{$HTTP_LISTEN_PORT:80} {
	handle /movil {
		root * {$MOBILE_ROOT:/srv-movil}
		rewrite * /index.html
		file_server
	}

	handle /sga-raiz.crt {
		root * {$CA_ROOT_DIR:/data/caddy/pki/authorities/local}
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}

	handle {
		redir https://{host}{$HTTPS_SUFFIX}{uri} 308
	}
}

{$SITE_ADDRESS:localhost} {
	tls {$TLS_MODE:internal}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}

	# La página del móvil y el certificado también se pueden abrir con HTTPS.
	handle /movil {
		root * {$MOBILE_ROOT:/srv-movil}
		rewrite * /index.html
		file_server
	}

	handle /sga-raiz.crt {
		root * {$CA_ROOT_DIR:/data/caddy/pki/authorities/local}
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle {
		root * {$WEB_ROOT:/srv}
		try_files {path} /index.html
		file_server

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}
}
